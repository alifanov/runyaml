{
  "name": "runyaml",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "runyaml": "pnpm --filter @runyaml/core run cli",
    "typecheck": "pnpm -r run typecheck",
    "web:up": "docker compose -f web/docker-compose.yml up --build",
    "web:down": "docker compose -f web/docker-compose.yml down",
    "web:logs": "docker compose -f web/docker-compose.yml logs -f"
  },
  "packageManager": "pnpm@9.15.0"
}
