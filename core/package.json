{
  "name": "runyaml",
  "version": "0.3.0",
  "private": false,
  "description": "Run YAML-defined DAG workflows from the CLI with a debug dashboard",
  "type": "module",
  "bin": {
    "runyaml": "./dist/cli.js"
  },
  "main": "./dist/runner.js",
  "types": "./dist/runner.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "cli": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
